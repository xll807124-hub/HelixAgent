# Populate a LOCAL untracked environment; never commit credentials.
# The runner reads process environment and does not automatically load a file.
OPENAI_API_KEY=
AI_MODEL_ID=
AI_MODEL_REVISION=
AI_MODEL_CONTEXT_WINDOW=
AI_MODEL_MAX_OUTPUT_TOKENS=2048
# USD per one million tokens * 1,000,000 (integer microUSD).
AI_MODEL_PRICE_INPUT_MICROUSD_PER_MTOKEN=
AI_MODEL_PRICE_OUTPUT_MICROUSD_PER_MTOKEN=
AI_MODEL_PRICING_VERSION=
# ISO 8601 time with timezone, e.g. a verified price validity deadline.
AI_MODEL_PRICING_VALID_UNTIL=
# Absolute LOCAL path, same DB for all processes sharing the task budget.
AI_MODEL_BUDGET_DB=
AI_MODEL_SMOKE_LIMIT_TOKENS=
AI_MODEL_SMOKE_LIMIT_MICROUSD=
